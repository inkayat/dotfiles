#!/usr/bin/env bash
# fm-update - bring the selected FirstMate distribution (FIRSTMATE_ROOT) and
# the dotfiles checkout that holds this firstmate-config to their remote tips,
# then reconcile this machine via firstmate-config/install.sh.
#
# Order:
#   1. Preconditions for BOTH repositories, before either is changed. Local
#      checks first; then the manifest's explicit branch and the dotfiles
#      remote are fetched (this only moves remote-tracking refs), and each
#      checkout must be a plain fast-forward of (or equal to) its upstream.
#   2. Fast-forward the FirstMate distribution checkout.
#   3. Fast-forward the dotfiles checkout. Its guards cover the whole
#      repository, not only firstmate-config/.
#   4. Run firstmate-config/install.sh, then install.sh --verify. The dotfiles
#      root install.sh (Herdr plugins) is never run.
# A refusal in step 1 changes neither working tree. A failure after step 2
# moved the distribution checkout is reported as a PARTIAL update, never as
# success; there is no multi-repository rollback.
#
# Every Git step is only ever a fast-forward. Nothing is forced, stashed,
# reset, merged, rebased, discarded, or pushed: a dirty or diverged checkout is
# reported and left exactly as it was, for a human to resolve. The distribution
# checkout must be a Git root with AGENTS.md, use the manifest's exact configured
# and effective origin URL, check out firstmate_branch tracking origin/<branch>,
# and set local origin/HEAD to that same branch for native bootstrap consistency.
# No unfinished operation or local commits missing from origin are allowed.
# Only the explicit distribution branch is fetched (never --prune, never
# upstream). Secondmates and
# projects are never updated, and a running Captain is never restarted or
# notified: it keeps the instructions it loaded at startup until it is
# restarted through the official procedure (end the session, run `fm` again).
# fm-update never reimplements any of install.sh's reconciliation steps.
#
# --core (passed by `fm-core update`) updates the fm-core profile instead:
# its own checkout from ~/.config/firstmate-config/core.env (default
# ~/Developer/tools/firstmate-core; an exported classic FIRSTMATE_ROOT or
# FM_CONFIG_ENV is ignored), then install.sh --core and --core --verify. The
# dotfiles checkout is shared with fm, so --core never fetches, checks or
# moves it; `fm update` owns that step.
#
# Usage: fm update [--check] (--check reads local refs only; no fetch/install)
set -u

CORE=0
ENTRY=fm
if [ "${1:-}" = --core ]; then
  CORE=1
  ENTRY=fm-core
  shift
  unset FIRSTMATE_ROOT
  ENV_FILE="$HOME/.config/firstmate-config/core.env"
else
  ENV_FILE="${FM_CONFIG_ENV:-$HOME/.config/firstmate-config/env}"
fi
# shellcheck source=/dev/null
[ ! -f "$ENV_FILE" ] || . "$ENV_FILE"

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self="$(cd "$(dirname "$self")" && pwd)/$target" ;; esac
done
CONFIG_ROOT="$(cd "$(dirname "$self")/.." && pwd)"
if [ "$CORE" -eq 1 ]; then
  FIRSTMATE_ROOT="${FIRSTMATE_ROOT:-$HOME/Developer/tools/firstmate-core}"
else
  FIRSTMATE_ROOT="${FIRSTMATE_ROOT:-$HOME/Developer/tools/firstmate}"
fi
export GIT_OPTIONAL_LOCKS=0

OFFICIAL_UPDATED= # "<old> -> <new>" once the official fast-forward has landed

restart_note() {
  printf 'A running Captain keeps the instructions it loaded at startup and was not restarted or notified.\n'
  printf 'To adopt the update later, end the Captain session, then run %s again.\n' "$ENTRY"
}
die() {
  printf 'fm-update: %s\n' "$1" >&2
  if [ -n "$OFFICIAL_UPDATED" ]; then
    printf 'fm-update: PARTIAL UPDATE: FirstMate distribution was fast-forwarded (%s), but the dotfiles/firstmate-config update did not complete; fix the error above and re-run %s update\n' "$OFFICIAL_UPDATED" "$ENTRY" >&2
    restart_note >&2
  fi
  exit 1
}
official_refuse() { die "FirstMate distribution checkout: $1; nothing was changed"; }
git_c() { git -C "$DOTFILES_ROOT" "$@"; }
git_f() { git -C "$FIRSTMATE_ROOT" "$@"; }

CHECK_ONLY=0
case ${1:-} in
  --help|-h) printf 'Usage: %s update [--check]\n--check: local guards and source resolution only; no fetch, update or install.\n' "$ENTRY"; exit 0 ;;
  --check) CHECK_ONLY=1 ;;
  '') ;;
  *) die "unknown argument '$1'; see fm update --help" ;;
esac
[ "$#" -le 1 ] || die 'too many arguments'

command -v git >/dev/null 2>&1 || die 'git is not on PATH'

# --- 1a. local preconditions, no network -----------------------------------

# shellcheck source=firstmate/fm-stack-manifest.sh
. "$CONFIG_ROOT/firstmate/fm-stack-manifest.sh"
stack_manifest_load "$CONFIG_ROOT/firstmate/stack-manifest.tsv" || die "$SM_LOAD_ERROR; nothing was changed"
official=$SM_FIRSTMATE_REPO

[ -d "$FIRSTMATE_ROOT" ] || official_refuse "$FIRSTMATE_ROOT does not exist"
top=$(git_f rev-parse --show-toplevel 2>/dev/null) \
  || official_refuse "$FIRSTMATE_ROOT is not a Git checkout"
[ "$(cd "$top" && pwd -P)" = "$(cd "$FIRSTMATE_ROOT" && pwd -P)" ] \
  || official_refuse "$FIRSTMATE_ROOT is inside $top, not the root of a checkout"
[ -f "$FIRSTMATE_ROOT/AGENTS.md" ] \
  || official_refuse "$FIRSTMATE_ROOT has no AGENTS.md"
urls=$(git_f config --get-all remote.origin.url) \
  || official_refuse "$FIRSTMATE_ROOT has no 'origin' remote; expected $official"
[ "$urls" = "$official" ] \
  || official_refuse "origin is '$(printf '%s' "$urls" | tr '\n' ' ')', expected exactly $official (to move a retired distribution source, see firstmate-config/README.md \"Moving a fork installation to official\")"
effective=$(git_f remote get-url origin)
[ "$effective" = "$official" ] \
  || official_refuse "origin is rewritten to '$effective' by Git config; expected exactly $official"
f_branch=$(git_f symbolic-ref --quiet --short HEAD) \
  || official_refuse "$FIRSTMATE_ROOT is on a detached HEAD"
[ "$f_branch" = "$SM_FIRSTMATE_BRANCH" ] \
  || official_refuse "$FIRSTMATE_ROOT is on '$f_branch', expected $SM_FIRSTMATE_BRANCH"
[ "$(git_f symbolic-ref --quiet refs/remotes/origin/HEAD)" = "refs/remotes/origin/$SM_FIRSTMATE_BRANCH" ] \
  || official_refuse "origin/HEAD must select origin/$SM_FIRSTMATE_BRANCH for native bootstrap; set it explicitly with git remote set-head origin $SM_FIRSTMATE_BRANCH"
f_git_dir=$(git_f rev-parse --absolute-git-dir) \
  || official_refuse "cannot resolve the Git directory of $FIRSTMATE_ROOT"
for op in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
  [ ! -e "$f_git_dir/$op" ] || official_refuse "$FIRSTMATE_ROOT has an unfinished Git operation ($op)"
done
if [ -n "$(git_f status --porcelain)" ]; then
  printf 'fm-update: uncommitted local changes in %s\n' "$FIRSTMATE_ROOT" >&2
  git_f status --short >&2
  official_refuse 'commit or remove them yourself, then re-run'
fi

DOTFILES_ROOT=$(git -C "$CONFIG_ROOT" rev-parse --show-toplevel 2>/dev/null) \
  || die "$CONFIG_ROOT is not inside a dotfiles Git checkout"
# fm-core shares this checkout with fm and never moves it, so it has no
# business refusing on the checkout's branch or working-tree state either.
if [ "$CORE" -eq 0 ]; then
  branch=$(git_c symbolic-ref --quiet --short HEAD) \
    || die "dotfiles checkout $DOTFILES_ROOT is on a detached HEAD; check out a branch first (nothing was changed)"
  remote=$(git_c config --get "branch.$branch.remote") || remote=origin
  old=$(git_c rev-parse --short HEAD)
  c_git_dir=$(git_c rev-parse --absolute-git-dir) \
    || die "cannot resolve the Git directory of $DOTFILES_ROOT; nothing was changed"
  for op in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    [ ! -e "$c_git_dir/$op" ] || die "dotfiles checkout $DOTFILES_ROOT has an unfinished Git operation ($op); nothing was changed"
  done

  # Refuse before touching the network: a dirty checkout - anywhere in the
  # dotfiles repository, not only firstmate-config/ - can never be
  # fast-forwarded safely, and this command will not decide what to do with it.
  if [ -n "$(git_c status --porcelain)" ]; then
    printf 'fm-update: uncommitted local changes in %s\n' "$DOTFILES_ROOT" >&2
    git_c status --short >&2
    die 'commit or stash them yourself, then re-run; nothing was changed'
  fi
fi

# --- 1b. remote preconditions; only remote-tracking refs move --------------

f_default=$SM_FIRSTMATE_BRANCH
printf 'Checking FirstMate distribution (%s, branch %s)...\n' "$official" "$f_default"
if [ "$(git_f config --get "branch.$f_branch.remote")" != origin ] \
  || [ "$(git_f config --get "branch.$f_branch.merge")" != "refs/heads/$f_default" ]; then
  official_refuse "branch '$f_branch' does not track origin/$f_default; set it with 'git -C $FIRSTMATE_ROOT branch -u origin/$f_default'"
fi
if [ "$CHECK_ONLY" -eq 0 ]; then
  printf 'Fetching FirstMate distribution origin/%s...\n' "$f_default"
  git_f fetch --quiet origin "refs/heads/$f_default:refs/remotes/origin/$f_default" \
    || official_refuse "cannot fast-forward-fetch '$f_default' from $official"
fi
f_upstream="origin/$f_default"
f_old=$(git_f rev-parse --short HEAD)
f_new=$(git_f rev-parse --short --verify "$f_upstream^{commit}") \
  || official_refuse "missing local $f_upstream; fetch the selected branch explicitly"
f_current=no
if [ "$(git_f rev-parse HEAD)" = "$(git_f rev-parse "$f_upstream")" ]; then
  f_current=yes
elif git_f merge-base --is-ancestor "$f_upstream" HEAD; then
  official_refuse "branch '$f_branch' has $(git_f rev-list --count "$f_upstream..HEAD") local commit(s) not on $f_upstream (unlanded work)"
elif ! git_f merge-base --is-ancestor HEAD "$f_upstream"; then
  official_refuse "branch '$f_branch' has diverged from $f_upstream ($f_old vs $f_new); resolve it manually"
fi

if [ "$CORE" -eq 0 ]; then
  if [ "$CHECK_ONLY" -eq 0 ]; then
    printf 'Fetching dotfiles %s...\n' "$remote"
    git_c fetch --quiet --prune "$remote" || die "cannot fetch from '$remote'; nothing was changed"
  fi
  upstream=$(git_c rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) \
    || die "branch '$branch' has no upstream; set one with 'git branch -u $remote/$branch'; nothing was changed"
  new=$(git_c rev-parse --short "$upstream")
  current=no
  if [ "$(git_c rev-parse HEAD)" = "$(git_c rev-parse "$upstream")" ]; then
    current=yes
  elif ! git_c merge-base --is-ancestor HEAD "$upstream"; then
    die "branch '$branch' has diverged from '$upstream' ($old vs $new); resolve it manually; nothing was changed"
  fi
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
  printf 'UPDATE_SOURCE: %s\nUPDATE_BRANCH: %s\nUPDATE_TARGET: %s\nVALIDATED_COMMIT: %s\n' \
    "$official" "$f_default" "$f_upstream" "$SM_FIRSTMATE_COMMIT"
  printf 'CHECK_ONLY: local refs; no fetch, update or install\n'
  exit 0
fi

# --- 2. FirstMate distribution -----------------------------------------------

if [ "$f_current" = yes ]; then
  printf 'FirstMate distribution already up to date: %s at %s (%s)\n' "$f_branch" "$f_old" "$f_upstream"
else
  git_f merge --ff-only --quiet "$f_upstream" \
    || official_refuse "fast-forward to $f_upstream failed"
  OFFICIAL_UPDATED="$f_old -> $f_new"
  printf 'Updated FirstMate distribution %s: %s -> %s (%s commits from %s)\n' \
    "$f_branch" "$f_old" "$f_new" "$(git_f rev-list --count "$f_old..HEAD")" "$f_upstream"
  git_f --no-pager log --oneline "$f_old..HEAD"
fi
printf '\n'

# --- 3. dotfiles --------------------------------------------------------------

run_install() { # [--verify]; the profile this update was started for
  if [ "$CORE" -eq 1 ]; then "$CONFIG_ROOT/install.sh" --core "$@"; else "$CONFIG_ROOT/install.sh" "$@"; fi
}
reconcile() { # <label> after the checkout is settled at its final commit
  printf '\nReconciling machine state (%s)...\n' "$1"
  install_out=$(run_install); install_status=$?
  printf '%s\n' "$install_out"
  [ "$install_status" -eq 0 ] \
    || die "install.sh failed after update; repository is at $(git_c rev-parse --short HEAD) but machine state was not reconciled"

  printf '\nVerifying reconciled state...\n'
  verify_out=$(run_install --verify); verify_status=$?
  printf '%s\n' "$verify_out"
  [ "$verify_status" -eq 0 ] \
    || die 'install.sh --verify failed after reconciling; investigate machine state'
  case $verify_out in
    *'verify: 0 drift item(s), 0 failure(s)'*) ;;
    *) die 'install.sh --verify reported drift after reconciling; investigate machine state' ;;
  esac
}

if [ "$CORE" -eq 1 ]; then
  printf 'Dotfiles checkout %s left at %s: it is shared with fm, and fm update moves it\n' \
    "$DOTFILES_ROOT" "$(git_c rev-parse --short HEAD)"
  reconcile 'fm-core profile'
elif [ "$current" = yes ]; then
  printf 'Already up to date: %s at %s (%s)\n' "$branch" "$old" "$upstream"
  reconcile 'already up to date'
else
  git_c merge --ff-only --quiet "$upstream" \
    || die "fast-forward to '$upstream' failed; dotfiles was not changed"
  printf 'Updated %s: %s -> %s (%s commits from %s)\n' \
    "$branch" "$old" "$new" "$(git_c rev-list --count "$old..HEAD")" "$upstream"
  git_c --no-pager log --oneline "$old..HEAD"
  reconcile 'updated to '"$new"
fi

# --- 4. summary -------------------------------------------------------------

if [ "$CORE" -eq 1 ]; then
  dotfiles_summary='not moved (shared with fm)'
elif [ "$current" = yes ]; then
  dotfiles_summary='already up to date'
else
  dotfiles_summary="$old -> $new"
fi
printf '\n%s update complete: FirstMate distribution %s; dotfiles %s; machine reconciled and verified.\n' \
  "$ENTRY" "${OFFICIAL_UPDATED:-already up to date}" "$dotfiles_summary"
[ -z "$OFFICIAL_UPDATED" ] || restart_note
printf 'Secondmates and projects were not updated.\n'
